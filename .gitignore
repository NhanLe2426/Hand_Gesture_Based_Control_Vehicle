# ========================================
# XILINX VIVADO (Hardware Slave)
# ========================================
# Ignore log and journal files generated during execution
*.jou
*.log
*.str

# Ignore Xilinx's temporary and hidden executable folders
.Xil/
runs/
*.pb
*.wdb
*.dir/

# Ignore bitstream and report files
*.bit
*.bin
*.xsa
*.rpt
*.dcp

# ========================================
# ARDUINO (Firmware Master)
# ========================================
# Ignore the build directory and compiled binary files
build/
*.elf
*.hex
*.bin
*.eep

# ========================================
# EDITORS & IDEs
# ========================================
# Ignore VS Code's personal workspace settings
.vscode/

# ========================================
# OS GENERATED FILES
# ========================================
# Ignore junk files automatically generated by the operating system
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db